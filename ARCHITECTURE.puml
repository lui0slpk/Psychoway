@startuml Psychoway_Architecture
!define DARK_GRAY #333333
!define LIGHT_GRAY #E8E8E8
!define PRIMARY_BLUE #0066CC
!define PRIMARY_GREEN #28A745
!define PRIMARY_ORANGE #FFC107
!define PRIMARY_RED #DC3545

' Colores personalizados
skinparam componentBackgroundColor LIGHT_GRAY
skinparam componentBorderColor DARK_GRAY
skinparam backgroundColor White
skinparam useBetaStyle true
skinparam linetype ortho

' ============================================
' C4 Model - System Context Diagram
' ============================================

title Psychoway - Arquitectura del Sistema

' Actores Externos
actor "👨 Aprendiz SENA" as Student
actor "🧑‍⚕️ Psicólogo" as Psychologist
actor "👨‍💼 Administrador" as Admin

' Sistema Principal
package "Psychoway Platform" <<system>> {
    
    ' ======== FRONTEND ========
    package "Frontend Layer - React SPA" <<component>> {
        [🎨 UI Components] as UIComp #PRIMARY_BLUE
        [📱 Emotion Diary] as EmoDiary #PRIMARY_GREEN
        [📅 Scheduler] as Scheduler #PRIMARY_GREEN
        [💬 Chat Interface] as ChatUI #PRIMARY_GREEN
        [📊 Dashboards] as Dashboards #PRIMARY_GREEN
        [🔐 Auth Module] as AuthFront #PRIMARY_BLUE
        
        UIComp -down- EmoDiary
        UIComp -down- Scheduler
        UIComp -down- ChatUI
        UIComp -down- Dashboards
        AuthFront -right- UIComp
    }
    
    ' ======== API GATEWAY ========
    package "API Layer - Express.js" <<component>> {
        [🚪 Entry Point] as Gateway #PRIMARY_ORANGE
        [🔒 Auth Middleware] as AuthMiddle #PRIMARY_BLUE
        [❌ Error Handler] as ErrorHandler #PRIMARY_BLUE
        [✅ CORS / Config] as Config #PRIMARY_BLUE
        
        Gateway -down- AuthMiddle
        AuthMiddle -down- Config
        Config -down- ErrorHandler
    }
    
    ' ======== BUSINESS LOGIC ========
    package "Business Logic Layer" <<component>> {
        
        package "Core Modules" {
            [🔑 Auth Service] as AuthService #PRIMARY_GREEN
            [😊 Emotion Service] as EmoService #PRIMARY_GREEN
            [📋 Schedule Service] as SchService #PRIMARY_GREEN
            [🤖 AI Chat Service] as AIService #PRIMARY_GREEN
            [👤 User Service] as UserService #PRIMARY_GREEN
            [📝 Diary/Objectives] as DiaryService #PRIMARY_GREEN
        }
        
        AuthService -right- EmoService
        EmoService -right- SchService
        SchService -right- AIService
        AIService -right- UserService
        UserService -right- DiaryService
    }
    
    ' ======== DATA LAYER ========
    package "Data Access Layer" <<component>> {
        
        package "Repositories" {
            [👥 User Repository] as Users
            [😔 Emotion Repository] as Emotions
            [📅 Meeting Repository] as Appointments
            [💬 Psychobot Repository] as Messages
            [📝 Diary Repository] as Diary
        }
        
        [🗂️ Database Adapter (pg Pool)] as DBAdapter #PRIMARY_BLUE
        
        DBAdapter -down- Users
        DBAdapter -down- Emotions
        DBAdapter -down- Appointments
        DBAdapter -down- Messages
        DBAdapter -down- Diary
    }
    
    ' ======== EXTERNAL SERVICES ========
    package "External Services" <<component>> {
        [🤖 Gemini AI\n(@google/genai)] as AIProvider #PRIMARY_ORANGE
        [📧 Nodemailer\n(SMTP)] as EmailService #PRIMARY_ORANGE
    }
}

' ======== CONEXIONES INTERNAS ========

' Frontend a Gateway
UIComp -right- Gateway : "HTTP/REST\nJSON/HTTPS"

' Gateway a Business Logic
ErrorHandler -down- AuthService : "Route to\nServices"
ErrorHandler -down- EmoService
ErrorHandler -down- SchService
ErrorHandler -down- AIService
ErrorHandler -down- UserService
ErrorHandler -down- DiaryService

' Business Logic a Data Layer
AuthService -down- DBAdapter : "SQL Queries\n(parametrizadas)"
EmoService -down- DBAdapter
SchService -down- DBAdapter
AIService -down- DBAdapter
UserService -down- DBAdapter
DiaryService -down- DBAdapter

' Business Logic a External Services
AIService -right- AIProvider : "Chat Context"
AuthService -right- EmailService : "Reset Link"

' ======== ACTORES EXTERNOS A SISTEMA ========

Student -left- UIComp : "Interactúa"
Psychologist -left- Dashboards : "Monitorea"
Admin -right- AuthService : "Administra"

Student -down- Gateway : "Autenticación"
Psychologist -down- Gateway
Admin -down- Gateway

' ======== NOTAS Y LEYENDA ========

note right of Student
  • Ver emociones
  • Agendar citas
  • Chat con IA
  • Progreso visual
end note

note right of Psychologist
  • Dashboard aprendices
  • Historial emocional
  • Gestionar citas
  • Reportes
end note

note right of Admin
  • Gestión usuarios
  • Analytics
  • Config sistema
  • Auditoría
end note

@enduml

' ============================================
' Data Flow Diagram - Autenticación
' ============================================

@startuml Psychoway_DataFlow
title Flujo de Datos - Autenticación

participant User as U
participant "Frontend\nReact"
participant "Express\nAPI" as Gateway
participant "Auth\nService"
participant "PostgreSQL\n(Supabase)" as DB

autonumber

U -> "Frontend\nReact": 1. Inicia sesión
"Frontend\nReact" -> Gateway: 2. POST /login\n{document, password}
Gateway -> "Auth\nService": 3. Validar credenciales
"Auth\nService" -> DB: 4. SELECT user WHERE document
DB --> "Auth\nService": 5. User + hashedPassword
"Auth\nService" --> Gateway: 6. JWT Token
Gateway --> "Frontend\nReact": 7. {token, user}
"Frontend\nReact" --> U: 8. Sesión iniciada

@enduml
