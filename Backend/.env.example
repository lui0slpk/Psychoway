# ==================== PSYCHOWAY - Variables de Entorno ====================
# Copia este archivo como .env y rellena los valores

# Servidor
PORT=5000
NODE_ENV=development

# ==================== SUPABASE / PostgreSQL ====================
# Obtener en: Supabase Dashboard → Settings → Database → Connection string
# Seleccionar modo "Session" (puerto 5432)
SUPABASE_URL=https://TU-PROJECT-ID.supabase.co
SUPABASE_DB_URL=postgresql://postgres:[TU-PASSWORD]@db.TU-PROJECT-ID.supabase.co:5432/postgres

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_seguro
JWT_EXPIRES_IN=8h

# Google Gemini AI
GEMINI_API_KEY=TU_API_KEY_DE_GEMINI

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password
EMAIL_FROM="Psychoway" <tu_email@gmail.com>

# Frontend URL
FRONTEND_URL=http://localhost:3000
