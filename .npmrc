# Docker Desktop en Windows tiene DNS/red lenta; evitamos que pnpm aborte.
# Valores en milisegundos. fetch-timeout = 10 min por request.
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=300000
# Menos concurrencia reduce la saturación del NAT de Docker.
network-concurrency=8